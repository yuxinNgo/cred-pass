pragma language_version >= 0.23;

import CompactStandardLibrary;

// Public IDs, credential types, expirations, revocations, and presentation nullifiers.
// Holder secrets remain private witnesses.
struct Registration {
  credentialType: Uint<8>;
  expiresAt: Uint<64>;
  holderCommitment: Bytes<32>;
}

export ledger credentials: Map<Bytes<32>, Registration>;
export sealed ledger issuerCommitment: Bytes<32>;
export ledger revoked: Set<Bytes<32>>;
export ledger presentationNullifiers: Set<Bytes<32>>;

witness issuerSecret(): Bytes<32>;
witness holderSecret(): Bytes<32>;

constructor() {
  issuerCommitment = disclose(issuerKey(issuerSecret()));
}

circuit issuerKey(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "credpass:issuer:v1"), secret]);
}

circuit assertIssuer(): [] {
  assert(issuerCommitment == issuerKey(issuerSecret()), "Unauthorized issuer");
}

export pure circuit holderKey(
  deployment: Bytes<32>,
  id: Bytes<32>,
  secret: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "credpass:holder:v2"), deployment, id, secret
  ]);
}

export circuit registerCredential(
  id: Bytes<32>, credentialType: Uint<8>, expiresAt: Uint<64>, holderCommitment: Bytes<32>
): [] {
  assertIssuer();
  assert(!credentials.member(disclose(id)), "Credential already registered");
  assert(credentialType < 3, "Unsupported credential type");
  assert(holderCommitment != default<Bytes<32>>, "Missing holder commitment");
  credentials.insert(disclose(id), disclose(Registration {
    credentialType: credentialType,
    expiresAt: expiresAt,
    holderCommitment: holderCommitment
  }));
}

export circuit revokeCredential(id: Bytes<32>): [] {
  assertIssuer();
  assert(credentials.member(disclose(id)), "Credential not registered");
  revoked.insert(disclose(id));
}

export circuit presentCredential(
  id: Bytes<32>, requiredType: Uint<8>, challenge: Bytes<32>
): Boolean {
  assert(disclose(challenge) != default<Bytes<32>>, "Missing verifier challenge");
  assert(credentials.member(disclose(id)), "Credential not registered");
  assert(!revoked.member(disclose(id)), "Credential revoked");
  const registered = credentials.lookup(disclose(id));
  assert(registered.credentialType == requiredType, "Credential type mismatch");
  assert(kernel.blockTimeLessThan(registered.expiresAt), "Credential expired");
  assert(
    registered.holderCommitment == holderKey(kernel.self().bytes, id, holderSecret()),
    "Invalid credential holder"
  );
  const nullifier = disclose(persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "credpass:presentation:v1"),
    kernel.self().bytes,
    id,
    registered.holderCommitment,
    challenge
  ]));
  assert(!presentationNullifiers.member(nullifier), "Verifier challenge already used");
  presentationNullifiers.insert(nullifier);
  return true;
}
