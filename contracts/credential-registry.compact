pragma language_version 0.18.0;

import CompactStandardLibrary;

// Development syntax prototype. Public synthetic IDs/types/expirations only.
// NOT a privacy-preserving registry, trusted issuer, or deployable proof system.
struct Registration {
  credentialType: Uint<8>;
  expiresAt: Uint<64>;
}

export ledger credentials: Map<Bytes<32>, Registration>;

export circuit registerDemoCredential(
  id: Bytes<32>, credentialType: Uint<8>, expiresAt: Uint<64>
): [] {
  assert(!credentials.member(disclose(id)), "Credential already registered");
  assert(credentialType < 3, "Unsupported credential type");
  credentials.insert(disclose(id), disclose(Registration {
    credentialType: credentialType,
    expiresAt: expiresAt
  }));
}

// trustedNow is a caller input in this prototype, NOT trusted ledger time.
// The next pass must bind issuer authorization, private credential commitments,
// holder ownership, authenticated time, and a verifier-specific challenge.
export circuit checkDemoValidity(
  id: Bytes<32>, requiredType: Uint<8>, trustedNow: Uint<64>
): Boolean {
  if (!credentials.member(disclose(id))) { return false; }
  const registered = credentials.lookup(disclose(id));
  return registered.credentialType == requiredType && registered.expiresAt > trustedNow;
}
