# Server-only Neon pooled URL (include the provider's TLS parameters).
DATABASE_URL=
# Direct/unpooled URL for migration script only.
DATABASE_URL_UNPOOLED=
# Server-only random 32-byte key, encoded as exactly 64 hexadecimal characters.
# Keep this stable and backed up. Changing it makes existing metadata unreadable.
CREDENTIAL_ENCRYPTION_KEY=
